# LLM API Keys (Set whichever provider you want to use)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
MISTRAL_API_KEY=your_openai_api_key_here

# Default Model Selection for LiteLLM
# Options: gemini/gemini-2.5-flash, groq/llama-3.3-70b-versatile, openai/gpt-4o-mini
MODEL_NAME=gemini/gemini-2.5-flash
