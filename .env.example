# LLM API Keys (Set whichever provider you want to use)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here

# Default Model Selection for LiteLLM
# Options: gemini/gemini-3.5-lite, gemini/gemini-3.6-flash, mistral/mistral-small-2506, groq/llama-3.3-70b-versatile
MODEL_NAME=gemini/gemini-3.5-lite
